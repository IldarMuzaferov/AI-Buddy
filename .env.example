# Скопируйте в .env (секретов в репозитории нет). LLM_PROVIDER: fake (без ключа) или openai_compatible.
DATABASE_URL=postgresql+asyncpg://buddy:buddy@db:5432/buddy
REDIS_URL=redis://redis:6379/0
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=__SET_ME__
LLM_MODEL=__MODEL_NAME__
EMBEDDINGS_MODEL=__MODEL_NAME__
JWT_SECRET=dev-only-secret
DEV_MODE=true
MCP_URL=http://mock-corp:8001
CORS_ORIGINS=*
